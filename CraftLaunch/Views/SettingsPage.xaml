<UserControl x:Class="CraftLaunch.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="540" d:DesignWidth="660">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,10,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="设置" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsDarkTheme}"
                              Content="深色模式"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="目录与运行环境" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock Text="游戏工作目录" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource WinTextBox}" Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{StaticResource WinButton}" Content="浏览..." Width="80" Margin="8,0,0,0"
                                Command="{Binding BrowseGameDirectoryCommand}"/>
                    </Grid>

                    <TextBlock Text="Java 路径 (java.exe)" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource WinTextBox}" Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{StaticResource WinButton}" Content="浏览..." Width="80" Margin="8,0,0,0"
                                Command="{Binding BrowseJavaPathCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource WinButton}" Content="自动检测" Width="90" Margin="8,0,0,0"
                                Command="{Binding DetectJavaCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding JavaStatus}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="网络代理" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ProxyEnabled}"
                              Content="启用代理（用于下载与联机请求）"/>

                    <Grid Margin="0,14,0,0" IsEnabled="{Binding ProxyEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="主机" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource WinTextBox}" Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource WinTextBox}" Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource AccentButton}" Content="保存设置" Width="132"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
