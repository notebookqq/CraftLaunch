<UserControl x:Class="CraftLaunch.Views.ContentDownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="560" d:DesignWidth="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource WinTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="搜索" Width="76" Margin="8,0,0,0"
                            Command="{Binding SearchCommand}"/>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="游戏版本" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox Style="{StaticResource WinComboBox}" Width="150" Margin="8,0,0,0"
                                  ItemsSource="{Binding GameVersions}"
                                  SelectedItem="{Binding SelectedGameVersion}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0"
                                IsEnabled="{Binding SupportsLoader}">
                        <TextBlock Text="加载器" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox Style="{StaticResource WinComboBox}" Width="110" Margin="8,0,0,0"
                                  ItemsSource="{Binding Loaders}"
                                  SelectedItem="{Binding SelectedLoader}"/>
                    </StackPanel>
                </Grid>

                <Border Margin="0,12,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="4" Background="{DynamicResource ControlFillBrush}" Padding="4"
                        Height="170">
                    <ListBox Style="{StaticResource WinListBox}"
                             ItemContainerStyle="{StaticResource WinListBoxItem}"
                             ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedProject}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DownloadsLabel, StringFormat=⬇ {0}}"
                                                   FontSize="12" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="下载选中项" Width="132"
                            Command="{Binding DownloadCommand}"/>
                    <TextBlock Text="{Binding DownloadStatus}" VerticalAlignment="Center" Margin="16,0,0,0"
                               FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="360"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ProgressBar Width="120" Margin="12,0,0,0" VerticalAlignment="Center"
                                 IsIndeterminate="{Binding IsDownloading}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="8,8,8,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource WinButton}" Content="刷新本地文件" Width="110" Height="30"
                                Command="{Binding RefreshLocalCommand}"/>
                        <Button Style="{StaticResource WinButton}" Content="删除选中" Width="96" Height="30" Margin="8,0,0,0"
                                Command="{Binding DeleteLocalCommand}"/>
                        <TextBlock Text="{Binding LocalSummary}" VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="1" Style="{StaticResource WinListBox}"
                         ItemContainerStyle="{StaticResource WinListBoxItem}"
                         ItemsSource="{Binding LocalFiles}"
                         SelectedItem="{Binding SelectedLocalFile}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SizeMB, StringFormat={}{0} MB}" FontSize="12"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
