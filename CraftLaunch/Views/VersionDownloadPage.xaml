<UserControl x:Class="CraftLaunch.Views.VersionDownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="480" d:DesignWidth="640">
    <Border Style="{StaticResource CardStyle}" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,4,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource WinTextBox}"
                         Text="{Binding VersionFilter, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Style="{StaticResource WinButton}" Content="刷新在线列表" Width="110" Margin="8,0,0,0"
                        Command="{Binding LoadRemoteCommand}"/>
                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" Content="显示快照/旧版" Margin="14,0,0,0"
                          IsChecked="{Binding ShowSnapshots}"/>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="4" Background="{DynamicResource ControlFillBrush}" Padding="4">
                <ListBox x:Name="VersionList"
                         Style="{StaticResource WinListBox}"
                         ItemContainerStyle="{StaticResource WinListBoxItem}"
                         ItemsSource="{Binding RemoteVersions}"
                         SelectedItem="{Binding SelectedRemoteVersion}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         MouseDoubleClick="OnVersionDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0"
                                        Background="{DynamicResource SubtleSelectedBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding ReleaseTime, StringFormat=yyyy-MM-dd}"
                                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,12,4,0">
                <Button Style="{StaticResource AccentButton}" Content="下载选中版本" Width="132"
                        Command="{Binding DownloadCommand}"/>
                <Button Style="{StaticResource WinButton}" Content="取消下载" Width="110" Margin="8,0,0,0"
                        Command="{Binding CancelDownloadCommand}"/>
                <ProgressBar Width="150" Margin="14,0,0,0" VerticalAlignment="Center" Maximum="100"
                             Value="{Binding DownloadPercent, Mode=OneWay}"
                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding DownloadStatus}" VerticalAlignment="Center" Margin="14,0,0,0"
                           FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="300"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
