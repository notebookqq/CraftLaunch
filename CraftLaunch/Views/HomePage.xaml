<UserControl x:Class="CraftLaunch.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="540" d:DesignWidth="660">
    <Grid Margin="32,10,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="主页" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,16">
            <StackPanel>
                <TextBlock Text="游戏版本" Style="{StaticResource FieldLabel}"/>
                <ComboBox Style="{StaticResource WinComboBox}"
                          ItemsSource="{Binding Versions}"
                          SelectedItem="{Binding SelectedVersion}"
                          DisplayMemberPath="Id"
                          MaxDropDownHeight="320"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource AccentButton}" Content="启动游戏" Width="132"
                            Command="{Binding LaunchCommand}"/>
                    <Button Style="{StaticResource WinButton}" Content="结束游戏进程" Width="132" Margin="8,0,0,0"
                            Command="{Binding StopCommand}"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <Separator/>

                <TextBlock Text="游戏路径" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource WinTextBox}"
                             Text="{Binding GamePath, UpdateSourceTrigger=LostFocus}"/>
                    <Button Grid.Column="1" Style="{StaticResource WinButton}" Content="浏览..." Width="80" Margin="8,0,0,0"
                            Command="{Binding BrowseGamePathCommand}"/>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="内存分配" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <Slider Grid.Column="1" Minimum="1024" Maximum="16384"
                            Value="{Binding MemoryMB}" IsSnapToTickEnabled="True" TickFrequency="256"
                            Margin="16,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding MemoryText}" VerticalAlignment="Center" Width="64"
                               TextAlignment="Right" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="运行日志" Margin="20,12,20,10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox Grid.Row="1" x:Name="LogBox"
                         Text="{Binding LogText, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="20,0,16,12"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
