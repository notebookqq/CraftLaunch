<Application x:Class="CraftLaunch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CraftLaunch.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Light.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:StringToVisibilityConverter x:Key="VisibleWhenNonEmpty"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:BoolToIndexConverter x:Key="BoolToIndex"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
