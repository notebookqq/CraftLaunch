<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CraftLaunch</RootNamespace>
    <AssemblyName>CraftLaunch</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.1.2</Version>
    <Product>CraftLaunch</Product>
    <Company>笔记本说电脑</Company>
    <Authors>笔记本说电脑</Authors>
    <Copyright>© 2026 笔记本说电脑</Copyright>
    <FileVersion>0.1.2</FileVersion>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <Description>Minecraft launcher built with native WPF and Fluent Design.</Description>
    <Version>0.1.0</Version>
    <Product>CraftLaunch</Product>
    <AssemblyTitle>CraftLaunch</AssemblyTitle>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="Start.bat" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
