<Window x:Class="CraftLaunch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:CraftLaunch.Controls"
        xmlns:vm="clr-namespace:CraftLaunch.ViewModels"
        xmlns:views="clr-namespace:CraftLaunch.Views"
        Title="CraftLaunch"
        Icon="pack://application:,,,/app.ico"
        Width="900" Height="600"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
            <views:VersionsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadViewModel}">
            <views:DownloadPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutPage/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent"/>

        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Border Width="22" Height="22" CornerRadius="6">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/app.ico"/>
                    </Border.Background>
                </Border>
                <TextBlock Text="CraftLaunch" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Foreground="{DynamicResource CaptionForegroundBrush}"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" Grid.Column="0"
                 Style="{StaticResource NavListBox}"
                 ItemsSource="{Binding NavItems}"
                 SelectedValue="{Binding CurrentKey, Mode=TwoWay}"
                 SelectedValuePath="Key"
                 ItemContainerStyle="{StaticResource NavListItem}"
                 VerticalAlignment="Top"/>

        <controls:AnimatedContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Current}" Focusable="False"/>
    </Grid>
</Window>
